# Copy this file to `.env` (repo root, and/or `backend/.env`) and fill in
# real values. NEVER commit your actual `.env` file (it's git-ignored).

# --- LLM provider ------------------------------------------------------
# "openai" (default, tested) or "anthropic"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.2

# --- Postgres (prompts, runs, LangGraph checkpoints) --------------------
# Used by both the backend app and docker-compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=research_assistant
# Local dev (no Docker): localhost. Inside docker-compose: host "postgres".
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/research_assistant

# --- Milvus Lite (embedded vector store; no server/docker needed) -------
MILVUS_LITE_PATH=./data/milvus_kb.db
MILVUS_COLLECTION=kb_documents

# --- Graph behaviour ------------------------------------------------------
MAX_REVISION_LOOPS=2
MAX_HUMAN_REVISION_LOOPS=2
WEB_SEARCH_MAX_RESULTS=3
KB_SEARCH_TOP_K=3

# --- API / CORS ----------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
